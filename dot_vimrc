colorscheme dracula
syntax enable
set nocompatible
execute pathogen#infect()
filetype plugin indent on
set smartindent
set ruler
set backspace=2
set tabstop=4
set softtabstop=4
set expandtab
set number
set showcmd
set cursorline
set wildmenu
set lazyredraw
set showmatch
set incsearch
set hlsearch
set whichwrap+=<,>,h,l,[,]
set laststatus=2
set t_Co=256
set mouse=a
set list
set textwidth=0
